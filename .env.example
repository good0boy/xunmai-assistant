# ============================================================
# 寻脉问诊助手 —— 环境配置模板
# 复制为 .env 后填写。.env 不进版本控制。
#
# 本文件按「本地开发」的相对路径写法给默认值；docker compose 部署时
# 容器内路径由 docker-compose.yml 的 environment 显式覆盖，这里的
# 路径写法不会生效，但值仍作为兜底。
# ============================================================

# ---------- 应用 ----------
APP_ENV=dev
APP_PORT=8080
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# 访问控制：**默认留空 = 不启用鉴权，所有人可用**（本机/内网信任环境）。
# 要限制访问时再填：APP_PASSCODE 给最终用户（前端弹口令框），ADMIN_TOKEN 给管理接口。
APP_PASSCODE=
ADMIN_TOKEN=
RATE_LIMIT_PER_MIN=20
DAILY_TOKEN_BUDGET=2000000

# ---------- 主对话模型（OpenAI 兼容端点） ----------
# base_url 按服务实际路由填写，不要想当然加 /v1：
#   DeepSeek 官方        https://api.deepseek.com        或 https://api.deepseek.com/v1
#   本地 LiteLLM 网关    http://10.0.0.1:4000             （很多部署挂在 host 根，没有 /v1）
# 程序只会在 base_url 后追加 /chat/completions，不会自动补 /v1。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=deepseek-chat
# 风格化输出，1.0-1.3 之间调试
LLM_TEMPERATURE=1.1
LLM_MAX_TOKENS=2500
LLM_TIMEOUT_S=180

# ---------- 工具型调用（改写 / 重排 / 摘要） ----------
UTILITY_MODEL=deepseek-chat
UTILITY_TEMPERATURE=0.0
UTILITY_MAX_TOKENS=800

# ---------- 视觉模型（可选；DeepSeek 无视觉能力，需另配） ----------
VLM_ENABLED=false
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
VLM_TIMEOUT_S=60

# ---------- Embedding（本地 ONNX，不依赖 torch） ----------
# 国内网络下模型下载必须走镜像，否则 HuggingFace 会超时。
# 离线环境：模型已随包放在 kb_src/models/，启动时自动拷到缓存目录，无需出网。
HF_ENDPOINT=https://hf-mirror.com
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DIM=512
# 64/8 是实测最优（建库 100+ 分钟 → 9 分钟）；显存/内存吃紧可降回 32/4
EMBED_BATCH=64
EMBED_THREADS=8
EMBED_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
# fastembed/HuggingFace 缓存目录（需可写，会建 .locks）
FASTEMBED_CACHE_PATH=kb_src/models
# 随包模型的源目录；留空用默认值。容器内由 compose 设为 /kb/models
KB_MODELS_DIR=kb_src/models

# ---------- 向量库 ----------
# server：连 Qdrant 服务（docker compose 默认）
# local ：进程内嵌 Qdrant，读本地目录（build_release 生成的单容器包用）
QDRANT_MODE=server
QDRANT_PATH=./runtime/qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tcm_kb

# ---------- 前端托管 ----------
# 留空则由 nginx 托管；单容器包填 ./web，由后端直接服 dist
FRONTEND_DIST=

# ---------- 检索 ----------
RAG_TOP_K_DENSE=40
RAG_TOP_K_SPARSE=40
RAG_RRF_K=60
# llm | onnx | none
RAG_RERANK_BACKEND=llm
RAG_RERANK_TOP_N=12
RAG_RERANK_MIN_SCORE=2
RAG_FINAL_K=5
RAG_MAX_CONTEXT_CHARS=4500
# llm | rules | off
RAG_QUERY_REWRITE=rules
RAG_DEGRADATION_MAX_LEVEL=3
RAG_MAX_CHUNKS_PER_DOC=3
RAG_VECTOR_WEIGHT=1.0
RAG_SPARSE_WEIGHT=1.0
RAG_FORMULA_BOOST=0.15
RAG_DISEASE_BOOST=0.10
RAG_SYMPTOM_BOOST=0.06
# 倪师解读组在跨组合并时的保底名额比例（0.5~0.7）
RAG_NIHAI_RATIO=0.65
# 经典原文的分数折扣：非同源时内容相近会让经典原文抢位，折扣让它稳定排后
RAG_CLASSICS_SCORE_SCALE=0.85

# ---------- 知识库构建 ----------
# 主语料根（倪师解读 43 个 Markdown）。注意：collect_chunks 会扫描整个
# KB_ROOT，不要指到包含 external/ 或 models/ 的上层目录。
# 容器内由 compose 设为 /kb/nihaixia。
KB_ROOT=./kb_src/nihaixia
# 外部语料根（经典原文 / 判语），与主语料分开建集合
KB_EXTERNAL_ROOT=kb_src/external
KB_TARGET_CHUNK_CHARS=700
KB_MAX_CHUNK_CHARS=1200
KB_MIN_CHUNK_CHARS=120
KB_OVERLAP_CHARS=80
KB_EMBED_CONTEXT_PREFIX=true

# ---------- 数据库 / 存储 ----------
# 相对 backend 运行目录；容器内由 compose 设为 sqlite+aiosqlite:////data/app.db
DB_URL=sqlite+aiosqlite:///../data/app.db
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_MB=8
IMAGE_MAX_EDGE=1600
IMAGE_RETENTION_DAYS=90

# ---------- 会话上下文 ----------
HISTORY_MAX_TURNS=3
HISTORY_TOKEN_BUDGET=2000
SUMMARY_TRIGGER_TOKENS=2500
EVIDENCE_TOKEN_BUDGET=4500

# ---------- 安全与合规 ----------
# standard | strict
DISCLAIMER_MODE=standard
RED_FLAG_ENABLED=true

# 索引自举源（发布包不含 Qdrant 索引，上传通道 1MB 限制）
KB_INDEX_SOURCES=http://10.10.47.114:8899/qdrant-index.tar.gz
